# Meta app credentials
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET

# Public URL of this Render service, for example https://page-doctor.onrender.com
APP_BASE_URL=https://YOUR-SERVICE.onrender.com

# Current Meta Graph API version
META_GRAPH_VERSION=v26.0

# Random secret for signing short-lived OAuth state
STATE_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
